@model IEnumerable<Vehiculo>
@{
    ViewData["Title"] = "Vehículos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-title mb-0">Vehículos</h2>
    @if (User.IsInRole(RolesSistema.Admin))
    {
        <a asp-controller="Home" asp-action="CrearItem" asp-route-tipo="Vehiculo" class="btn btn-sm btn-red-custom">
            <i class="bi bi-plus-circle"></i> Nuevo Vehículo
        </a>
    }
</div>

@if (!Model.Any())
{
    <div class="card"><div class="card-body text-center text-muted py-5">Aún no hay vehículos registrados.</div></div>
}
else
{
    <div class="row g-3">
        @foreach (var v in Model)
        {
            <div class="col-sm-6 col-lg-3">
                <partial name="_TarjetaCatalogo" model="@(v.Id, "Vehiculos", $"{v.Marca} {v.Modelo}", $"{v.Anio} · {v.Transmision}", v.Precio, v.Estado, v.ImagenUrl, "bi-car-front")" />
            </div>
        }
    </div>
}