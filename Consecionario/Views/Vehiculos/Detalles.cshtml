@model Vehiculo
@{
    ViewData["Title"] = $"{Model.Marca} {Model.Modelo}";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-black-custom text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0">@Model.Marca @Model.Modelo (@Model.Anio)</h4>
                <span class="badge @(Model.Estado == "Disponible" ? "bg-success" : "bg-secondary")">@Model.Estado</span>
            </div>
            <div class="card-body p-4">
                @if (!string.IsNullOrWhiteSpace(Model.ImagenUrl))
                {
                    <div class="text-center mb-4">
                        <img src="@Model.ImagenUrl" alt="@Model.Marca @Model.Modelo" class="img-fluid rounded" style="max-height: 320px; object-fit: cover;" />
                    </div>
                }
                <dl class="row mb-0">
                    <dt class="col-sm-4">Marca</dt>
                    <dd class="col-sm-8">@Model.Marca</dd>

                    <dt class="col-sm-4">Modelo</dt>
                    <dd class="col-sm-8">@Model.Modelo</dd>

                    <dt class="col-sm-4">Año</dt>
                    <dd class="col-sm-8">@Model.Anio</dd>

                    <dt class="col-sm-4">Transmisión</dt>
                    <dd class="col-sm-8">@Model.Transmision</dd>

                    <dt class="col-sm-4">Precio</dt>
                    <dd class="col-sm-8"><strong class="text-red-custom">@Model.Precio.ToString("C0", new System.Globalization.CultureInfo("es-CR"))</strong></dd>
                </dl>
            </div>
            <div class="card-footer bg-light d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
                @if (User.IsInRole(RolesSistema.Admin))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-red-custom"><i class="bi bi-pencil"></i> Editar</a>
                }
            </div>
        </div>
    </div>
</div>