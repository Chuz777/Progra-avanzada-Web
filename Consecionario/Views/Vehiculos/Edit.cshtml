@model Vehiculo
@{
    ViewData["Title"] = "Editar vehículo";
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">
        <div class="card">
            <div class="card-header card-header-black">
                <h5 class="mb-0"><i class="bi bi-pencil-square"></i> Editar vehículo</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Marca" class="form-label"></label>
                            <input asp-for="Marca" class="form-control" />
                            <span asp-validation-for="Marca" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Modelo" class="form-label"></label>
                            <input asp-for="Modelo" class="form-control" />
                            <span asp-validation-for="Modelo" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Anio" class="form-label">Año</label>
                            <input asp-for="Anio" type="number" class="form-control" />
                            <span asp-validation-for="Anio" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Transmision" class="form-label">Transmisión</label>
                            <select asp-for="Transmision" class="form-select">
                                <option value="Automática">Automática</option>
                                <option value="Manual">Manual</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Placa" class="form-label"></label>
                            <input asp-for="Placa" class="form-control text-uppercase" />
                            <span asp-validation-for="Placa" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Vin" class="form-label">VIN</label>
                            <input asp-for="Vin" class="form-control text-uppercase" />
                            <span asp-validation-for="Vin" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Precio" class="form-label">Precio ($)</label>
                            <input asp-for="Precio" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="Precio" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Estado" class="form-label"></label>
                            <select asp-for="Estado" class="form-select">
                                <option value="Disponible">Disponible</option>
                                <option value="Reservado">Reservado</option>
                                <option value="Vendido">Vendido</option>
                            </select>
                            <span asp-validation-for="Estado" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ImagenUrl" class="form-label">URL de la imagen</label>
                        <input asp-for="ImagenUrl" class="form-control" placeholder="https://..." />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-red-custom">Guardar cambios</button>
                        <a asp-action="Detalles" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
