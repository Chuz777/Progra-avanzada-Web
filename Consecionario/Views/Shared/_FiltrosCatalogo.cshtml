@* Filtros del catálogo (HU-08). Lee el filtro actual desde ViewBag.Filtro *@
@{
    var f = (FiltroCatalogoDto)ViewBag.Filtro;
}

<div class="card mb-4">
    <div class="card-body">
        <form asp-controller="@f.Controlador" asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label" for="marca">Marca</label>
                <input type="text" id="marca" name="marca" value="@f.Marca" class="form-control" placeholder="Ej. Honda" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="precioMax">Precio máximo ($)</label>
                <input type="number" id="precioMax" name="precioMax" value="@f.PrecioMax" min="0" step="0.01" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="estado">Estado</label>
                <select id="estado" name="estado" class="form-select">
                    <option value="">Todos</option>
                    @foreach (var e in new[] { "Disponible", "Reservado", "Vendido" })
                    {
                        <option value="@e" selected="@(e == f.Estado)">@e</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-red-custom flex-fill"><i class="bi bi-funnel"></i> Filtrar</button>
                <a asp-controller="@f.Controlador" asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
            </div>
        </form>
    </div>
</div>
