@{
    ViewData["Title"] = "No encontrado";
}

<div class="card mx-auto text-center" style="max-width: 520px;">
    <div class="card-header card-header-black"><h5 class="mb-0"><i class="bi bi-search"></i> No encontrado</h5></div>
    <div class="card-body p-4">
        <p class="mb-4">No encontramos lo que busca. Es posible que el registro no exista o ya haya sido eliminado.</p>
        <a class="btn btn-red-custom" asp-controller="Home" asp-action="Index">Volver al inicio</a>
    </div>
</div>
