@* Tarjeta reutilizable de catálogo (vehículo o moto). Model: ValueTuple de datos ya preparados *@
@model (string Titulo, string Subtitulo, decimal Precio, string Estado, string ImagenUrl, string Icono)

<div class="card h-100 catalogo-card">
    <div class="catalogo-img-wrap">
        <div class="catalogo-placeholder"><i class="bi @Model.Icono"></i></div>
        @if (!string.IsNullOrWhiteSpace(Model.ImagenUrl))
        {
            <img src="@Model.ImagenUrl" alt="@Model.Titulo" class="catalogo-img" loading="lazy" onerror="this.style.display='none'" />
        }
    </div>
    <div class="card-body">
        <h6 class="mb-1">@Model.Titulo</h6>
        <p class="text-muted small mb-2">@Model.Subtitulo</p>
        <div class="d-flex justify-content-between align-items-center">
            <strong class="text-red-custom">@Model.Precio.ToString("C0", new System.Globalization.CultureInfo("es-CR"))</strong>
            <span class="badge @(Model.Estado == "Disponible" ? "bg-success" : "bg-secondary")">@Model.Estado</span>
        </div>
    </div>
</div>
