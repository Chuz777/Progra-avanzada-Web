@* Tarjeta reutilizable de catálogo (vehículo o moto). Model: ValueTuple de datos ya preparados *@
@model (int Id, string Controlador, string Titulo, string Subtitulo, decimal Precio, string Estado, string ImagenUrl, string Icono)

@{
    var puedeGestionar = User.IsInRole(RolesSistema.Admin) ||
                         (Model.Controlador == "Accesorios" && User.IsInRole(RolesSistema.Dependiente));
}

<div class="card h-100 catalogo-card">
    <div class="catalogo-img-wrap">
        <div class="catalogo-placeholder"><i class="bi @Model.Icono"></i></div>
        @if (!string.IsNullOrWhiteSpace(Model.ImagenUrl))
        {
            <img src="@Model.ImagenUrl" alt="@Model.Titulo" class="catalogo-img" loading="lazy" onerror="this.style.display='none'" />
        }
    </div>
    <div class="card-body d-flex flex-column">
        <h6 class="mb-1">@Model.Titulo</h6>
        <p class="text-muted small mb-2">@Model.Subtitulo</p>
        <div class="d-flex justify-content-between align-items-center mt-auto">
            <strong class="text-red-custom">@Model.Precio.ToString("C0", new System.Globalization.CultureInfo("es-CR"))</strong>
            <span class="badge @(Model.Estado == "Disponible" ? "bg-success" : "bg-secondary")">@Model.Estado</span>
        </div>
    </div>

    <div class="card-footer bg-transparent border-top-0 pt-0 d-flex justify-content-between align-items-center gap-1">
        <a asp-controller="@Model.Controlador" asp-action="Detalles" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-dark">
            <i class="bi bi-eye"></i> Ver
        </a>

        @if (puedeGestionar)
        {
            <div class="d-flex gap-1">
                <a asp-controller="@Model.Controlador" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-warning">
                    <i class="bi bi-pencil"></i>
                </a>
                <form asp-controller="@Model.Controlador" asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline"
                      onsubmit="return confirm('¿Seguro que deseas eliminar este registro?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-trash"></i>
                    </button>
                </form>
            </div>
        }
    </div>
</div>
