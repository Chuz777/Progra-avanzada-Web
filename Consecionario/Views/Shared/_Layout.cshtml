<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ConcesionarioN</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-black-custom border-bottom-red mb-4">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-car-front-fill text-red-custom"></i>
                    Concesionario<span class="text-red-custom">N</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal" aria-expanded="false" aria-label="Mostrar menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menuPrincipal">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Vehiculos" asp-action="Index"><i class="bi bi-car-front"></i> Vehículos</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Motos" asp-action="Index"><i class="bi bi-bicycle"></i> Motos</a></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Accesorios" asp-action="Index"><i class="bi bi-gear"></i> Accesorios</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="TallerCitas" asp-action="Index"><i class="bi bi-tools"></i> Taller</a></li>
                            @if (User.IsInRole(RolesSistema.Admin) || User.IsInRole(RolesSistema.Dependiente))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Ventas" asp-action="Index"><i class="bi bi-cash-coin"></i> Ventas</a></li>
                            }
                            @if (User.IsInRole(RolesSistema.Admin))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Usuarios" asp-action="Index"><i class="bi bi-people"></i> Usuarios</a></li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-red-custom fw-semibold" href="#" id="menuAgregar" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-plus-circle-fill"></i> Agregar
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-dark border-danger" aria-labelledby="menuAgregar">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Home" asp-action="CrearItem" asp-route-tipo="Vehiculo">
                                                <i class="bi bi-car-front text-red-custom"></i> Nuevo Vehículo
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Home" asp-action="CrearItem" asp-route-tipo="Moto">
                                                <i class="bi bi-bicycle text-red-custom"></i> Nueva Moto
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider border-secondary" /></li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Home" asp-action="CrearItem" asp-route-tipo="Accesorio">
                                                <i class="bi bi-gear text-red-custom"></i> Nuevo Accesorio
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var rol = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
                            <li class="nav-item me-lg-3 text-light small">
                                <i class="bi bi-person-circle"></i> @User.Identity?.Name
                                <span class="badge badge-rol-@rol.ToLower()">@rol</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-light"><i class="bi bi-box-arrow-right"></i> Cerrar sesión</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Iniciar sesión</a></li>
                            <li class="nav-item ms-lg-2"><a class="btn btn-sm btn-red-custom" asp-controller="Account" asp-action="Registro">Registrarse</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-4">
            @if (TempData["Exito"] is string exito)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill"></i> @exito
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i> @error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">
            © 2026 - Concesionario<span class="text-red-custom">N</span> - SC-701 Programación Avanzada en Web
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
