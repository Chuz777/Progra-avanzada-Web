@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="card mx-auto" style="max-width: 600px;">
    <div class="card-header card-header-black"><h5 class="mb-0">Ocurrió un error</h5></div>
    <div class="card-body">
        <p>No pudimos procesar su solicitud. Intente de nuevo o vuelva al inicio.</p>
        @if (Model.ShowRequestId)
        {
            <p class="text-muted small mb-3"><strong>ID de solicitud:</strong> <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-red-custom" asp-controller="Home" asp-action="Index">Volver al inicio</a>
    </div>
</div>
