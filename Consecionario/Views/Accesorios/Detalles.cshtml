@model Accesorio
@{
    ViewData["Title"] = Model.Nombre;
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-black-custom text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0">@Model.Nombre</h4>
                <span class="badge @(Model.Stock > 0 ? "bg-success" : "bg-secondary")">@(Model.Stock > 0 ? "Disponible" : "Agotado")</span>
            </div>
            <div class="card-body p-4">
                @if (!string.IsNullOrWhiteSpace(Model.ImagenUrl))
                {
                    <div class="text-center mb-4">
                        <img src="@Model.ImagenUrl" alt="@Model.Nombre" class="img-fluid rounded" style="max-height: 320px; object-fit: cover;" onerror="this.style.display='none'" />
                    </div>
                }
                <dl class="row mb-0">
                    <dt class="col-sm-4">Código</dt>
                    <dd class="col-sm-8">@Model.Id</dd>

                    <dt class="col-sm-4">Nombre</dt>
                    <dd class="col-sm-8">@Model.Nombre</dd>

                    <dt class="col-sm-4">Categoría</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Categoria) ? "—" : Model.Categoria)</dd>

                    <dt class="col-sm-4">Stock disponible</dt>
                    <dd class="col-sm-8">@Model.Stock</dd>

                    <dt class="col-sm-4">Precio</dt>
                    <dd class="col-sm-8"><strong class="text-red-custom">@Model.Precio.ToString("C0", new System.Globalization.CultureInfo("en-US"))</strong></dd>
                </dl>
            </div>
            <div class="card-footer bg-light d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
                @if (User.IsInRole(RolesSistema.Admin) || User.IsInRole(RolesSistema.Dependiente))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-red-custom"><i class="bi bi-pencil"></i> Editar</a>
                }
            </div>
        </div>
    </div>
</div>
