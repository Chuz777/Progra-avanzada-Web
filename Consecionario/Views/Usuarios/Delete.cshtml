@model Usuario
@{
    ViewData["Title"] = "Eliminar usuario";
    bool tieneMovimientos = ViewBag.TieneMovimientos;
    bool esCuentaPropia = ViewBag.EsCuentaPropia;
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card">
            <div class="card-header card-header-black">
                <h5 class="mb-0"><i class="bi bi-trash"></i> Eliminar usuario</h5>
            </div>
            <div class="card-body p-4">
                <p class="mb-3">¿Confirma que desea eliminar a <strong>@Model.Nombre</strong> (@Model.Email)?</p>

                @if (esCuentaPropia)
                {
                    <div class="alert alert-danger mb-0">No puede eliminar su propia cuenta.</div>
                }
                else if (tieneMovimientos)
                {
                    <div class="alert alert-warning mb-0">
                        Este usuario tiene ventas, reservas o citas asociadas. No se eliminará: se <strong>desactivará</strong>,
                        no podrá iniciar sesión y se conservarán sus movimientos.
                    </div>
                }
                else
                {
                    <div class="alert alert-warning mb-0">Este usuario no tiene movimientos, se <strong>eliminará</strong> de forma permanente.</div>
                }
            </div>
            <div class="card-footer bg-white">
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                    @if (!esCuentaPropia)
                    {
                        <button type="submit" class="btn btn-red-custom">@(tieneMovimientos ? "Desactivar" : "Eliminar")</button>
                    }
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>
