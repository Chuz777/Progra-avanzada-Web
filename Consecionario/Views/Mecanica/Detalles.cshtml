@model TallerCita
@{
    ViewData["Title"] = $"Recepción REC-{Model.Id:000}";
    bool esPersonal = ViewBag.EsPersonal;
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card">
            <div class="card-header card-header-black d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-tools"></i> Recepción REC-@Model.Id.ToString("000")</h5>
                <partial name="_EstadoTaller" model="Model.EstadoTaller" />
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Fecha de ingreso</dt><dd class="col-sm-8">@Model.FechaIngreso.ToString("dd/MM/yyyy HH:mm")</dd>
                    <dt class="col-sm-4">Cliente</dt><dd class="col-sm-8">@Model.ClienteNombre</dd>
                    @if (esPersonal)
                    {
                        <dt class="col-sm-4">Teléfono</dt><dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.ClienteTelefono) ? "—" : Model.ClienteTelefono)</dd>
                        <dt class="col-sm-4">Correo</dt><dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.ClienteEmail) ? "—" : Model.ClienteEmail)</dd>
                    }
                    <dt class="col-sm-4">Placa</dt><dd class="col-sm-8">@Model.PlacaVehiculo</dd>
                    <dt class="col-sm-4">Estado del vehículo</dt><dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.EstadoVehiculo) ? "—" : Model.EstadoVehiculo)</dd>
                    <dt class="col-sm-4">Problema</dt><dd class="col-sm-8">@Model.DescripcionProblema</dd>
                    <dt class="col-sm-4">Último cambio de estado</dt><dd class="col-sm-8">@(Model.FechaCambioEstado?.ToString("dd/MM/yyyy HH:mm") ?? "—")</dd>
                </dl>

                @if (esPersonal)
                {
                    <hr />
                    <form asp-action="CambiarEstado" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-end">
                        <div class="col-md-6">
                            <label class="form-label" for="nuevoEstado">Cambiar estado</label>
                            <select id="nuevoEstado" name="nuevoEstado" class="form-select">
                                @foreach (var e in EstadosTaller.Todos)
                                {
                                    <option value="@e" selected="@(e == Model.EstadoTaller)">@e</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-red-custom w-100"><i class="bi bi-arrow-repeat"></i> Actualizar estado</button>
                        </div>
                    </form>
                }
            </div>
            <div class="card-footer bg-white d-flex justify-content-between flex-wrap gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
                @if (User.IsInRole(RolesSistema.Admin))
                {
                    <form asp-action="Eliminar" asp-route-id="@Model.Id" method="post" class="d-inline"
                          onsubmit="return confirm('¿Eliminar esta recepción? Solo se permite si está en estado Recibido.');">
                        <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash"></i> Eliminar recepción</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
