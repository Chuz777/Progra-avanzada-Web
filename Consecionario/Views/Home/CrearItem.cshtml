@model ConcesionarioN.Models.CrearProductoViewModel
@{
    ViewData["Title"] = "Registrar en Catálogo";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-black-custom text-white py-3 d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="bi bi-plus-circle text-red-custom"></i> Registrar en Catálogo</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="CrearItem" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Selector de Tipo -->
                        <div class="mb-4 p-3 bg-light rounded border">
                            <label class="form-label fw-bold text-uppercase small">¿Qué deseas agregar al sistema?</label>
                            <select asp-for="TipoProducto" id="selectorTipo" class="form-select form-select-lg border-danger" onchange="actualizarFormulario()">
                                <option value="Vehiculo">Vehículo (Automóvil)</option>
                                <option value="Moto">Motocicleta</option>
                                <option value="Accesorio">Accesorio / Repuesto</option>
                            </select>
                        </div>

                        <!-- SECCIÓN: SOLO ACCESORIO -->
                        <div id="bloqueAccesorio" style="display:none;">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Nombre del Accesorio</label>
                                    <input asp-for="Nombre" class="form-control" placeholder="Ej. Casco Integral DOT" />
                                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Categoría</label>
                                    <input asp-for="Categoria" class="form-control" placeholder="Ej. Seguridad" />
                                    <span asp-validation-for="Categoria" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Stock Disponible (Unidades)</label>
                                    <input asp-for="Stock" type="number" class="form-control" placeholder="Ej. 15" />
                                    <span asp-validation-for="Stock" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">URL de la Imagen</label>
                                    <input asp-for="ImagenUrl" class="form-control" placeholder="https://..." />
                                </div>
                            </div>
                        </div>

                        <!-- SECCIÓN: COMPARTIDA VEHÍCULO Y MOTO -->
                        <div id="bloqueVehiculoMoto">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Marca</label>
                                    <input asp-for="Marca" class="form-control" placeholder="Ej. Toyota / Yamaha" />
                                    <span asp-validation-for="Marca" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Modelo</label>
                                    <input asp-for="Modelo" class="form-control" placeholder="Ej. Corolla / MT-03" />
                                    <span asp-validation-for="Modelo" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Año</label>
                                    <input asp-for="Anio" type="number" class="form-control" placeholder="Ej. 2024" />
                                    <span asp-validation-for="Anio" class="text-danger small"></span>
                                </div>

                                <!-- SOLO VEHÍCULO -->
                                <div class="col-md-6 mb-3" id="campoTransmision">
                                    <label class="form-label">Transmisión</label>
                                    <select asp-for="Transmision" class="form-select">
                                        <option value="Automática">Automática</option>
                                        <option value="Manual">Manual</option>
                                    </select>
                                </div>

                                <!-- SOLO MOTO -->
                                <div class="col-md-6 mb-3" id="campoCilindraje" style="display:none;">
                                    <label class="form-label">Cilindraje (CC)</label>
                                    <input asp-for="CilindrajeCC" class="form-control" placeholder="Ej. 321 cc" />
                                    <span asp-validation-for="CilindrajeCC" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Placa</label>
                                    <input asp-for="Placa" class="form-control text-uppercase" placeholder="Ej. BCD123" />
                                    <span asp-validation-for="Placa" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">VIN</label>
                                    <input asp-for="Vin" class="form-control text-uppercase" placeholder="Ej. JTDBR32E720123456" />
                                    <span asp-validation-for="Vin" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">URL de la Imagen</label>
                                <input asp-for="ImagenUrl" class="form-control" placeholder="https://..." />
                                <div class="form-text">La unidad se registra con estado Disponible.</div>
                            </div>
                        </div>

                        <!-- PRECIO (PARA LOS 3) -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">Precio ($)</label>
                            <input asp-for="Precio" type="number" step="0.01" class="form-control form-control-lg" placeholder="0.00" />
                            <span asp-validation-for="Precio" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-red-custom px-4">Guardar y Publicar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Muestra solo los campos del tipo elegido y DESHABILITA los ocultos,
        // para que no se envíen (así no hay campos repetidos como ImagenUrl).
        function alternarBloque(bloque, visible) {
            bloque.style.display = visible ? "block" : "none";
            bloque.querySelectorAll("input, select").forEach(function (el) { el.disabled = !visible; });
        }

        function actualizarFormulario() {
            const tipo = document.getElementById("selectorTipo").value;
            const esAcc = tipo === "Accesorio";

            alternarBloque(document.getElementById("bloqueAccesorio"), esAcc);
            alternarBloque(document.getElementById("bloqueVehiculoMoto"), !esAcc);

            if (!esAcc) {
                alternarBloque(document.getElementById("campoTransmision"), tipo === "Vehiculo");
                alternarBloque(document.getElementById("campoCilindraje"), tipo === "Moto");
            }
        }

        // Ejecutar al cargar por si hubo un error de validación y volvió con un tipo seleccionado
        document.addEventListener("DOMContentLoaded", actualizarFormulario);
    </script>
}
